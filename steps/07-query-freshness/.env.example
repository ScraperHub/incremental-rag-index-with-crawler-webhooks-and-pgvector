# Crawlbase Crawling API / Crawler token (Normal or JS, matching the crawler).
CRAWLBASE_TOKEN=

# Dashboard crawler name (webhook delivery mode, not Cloud Storage).
CRAWLER_NAME=incremental-rag

# Shared secret checked as ?token= on POST /webhook.
WEBHOOK_TOKEN=change-me

# Postgres (matches docker-compose.yml).
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# OpenAI — swap models via env without code changes.
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Optional waits for JS-rendered docs (milliseconds). Requires a JS-token crawler.
# PAGE_WAIT=2000
# AJAX_WAIT=2000

# Recrawl: 0 disables the in-process scheduler (use cron + recrawl.py instead).
RECRAWL_INTERVAL_HOURS=24
